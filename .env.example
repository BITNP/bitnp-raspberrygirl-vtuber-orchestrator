ORCHESTRATOR_SERVICE_NAME=orchestrator
ORCHESTRATOR_SERVICE_VERSION=0.1.0
ORCHESTRATOR_SESSION_ID_PREFIX=session-placeholder
# Keep mock for ordinary credential-free development. The values below are the
# required production shape for the onsite spoken-dialogue bridge.
ORCHESTRATOR_LLM_PROVIDER=openai_compatible
ORCHESTRATOR_LLM_ENDPOINT=https://llm.example.test/v1
ORCHESTRATOR_LLM_MODEL=<openai-compatible-llm-model>
ORCHESTRATOR_LLM_API_KEY=<llm-api-key-placeholder>
ORCHESTRATOR_ASR_PROVIDER=openai_compatible
ORCHESTRATOR_ASR_ENDPOINT=https://asr.example.test/v1
ORCHESTRATOR_ASR_MODEL=<openai-compatible-asr-model>
ORCHESTRATOR_ASR_API_KEY=<asr-api-key-placeholder>
ORCHESTRATOR_TTS_PROVIDER=vllm_omni
ORCHESTRATOR_TTS_ENDPOINT=https://tts.example.test/v1
ORCHESTRATOR_TTS_MODEL=<vllm-omni-tts-model>
ORCHESTRATOR_TTS_API_KEY=<tts-api-key-placeholder>
# Voice identity is sent to the vLLM-Omni OpenAI-compatible TTS extension.
ORCHESTRATOR_TTS_VOICE=<voice-id>
# Local absolute WAV paths and file:// WAV URIs are encoded to data URLs before
# the TTS request; prebuilt data:audio/wav;base64 URLs are passed through.
ORCHESTRATOR_TTS_REF_AUDIO=/run/secrets/voice-reference.wav
ORCHESTRATOR_TTS_REF_TEXT=<voice-reference-transcript>
# Mount one PEM CA bundle read-only for the Orchestrator WSS listener and each
# self-hosted ASR, LLM, and TTS HTTPS endpoint. The bundle may include roots and intermediates.
ORCHESTRATOR_TLS_CA_PATH=/run/secrets/internal-ca-bundle.pem
# `orchestrator-transport` accepts authenticated WSS control on this listener.
# Set this token only in the deployment secret store, never in this file or source control.
TRUSTED_LAN_TOKEN=<trusted-lan-token-placeholder>
# Listener addresses owned by the Orchestrator transport process.
ORCHESTRATOR_CONTROL_BIND_HOST=0.0.0.0
ORCHESTRATOR_CONTROL_BIND_PORT=8443
ORCHESTRATOR_RTP_BIND_HOST=0.0.0.0
ORCHESTRATOR_RTP_BIND_PORT=5004
# Reachable LAN endpoint that Mic and Sound are configured to use. It can differ
# from a bind address or port when a firewall or TCP/UDP forwarding rule is present.
ORCHESTRATOR_TRANSPORT_ADVERTISED_HOST=orchestrator.example.test
ORCHESTRATOR_TRANSPORT_ADVERTISED_CONTROL_PORT=443
ORCHESTRATOR_TRANSPORT_ADVERTISED_RTP_PORT=5004
# Provision the certificate and private key outside this repository, then mount them
# read-only at these paths. These are paths only, not certificate or key contents.
ORCHESTRATOR_CONTROL_TLS_CERT_PATH=/run/secrets/orchestrator-control.crt
ORCHESTRATOR_CONTROL_TLS_KEY_PATH=/run/secrets/orchestrator-control.key
# `true` permits insecure WS only when every bind and advertised host is loopback.
# It is for integration tests, never for a LAN deployment.
ORCHESTRATOR_TRANSPORT_ALLOW_LOOPBACK_WS=false
