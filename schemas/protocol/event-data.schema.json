{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bitnp.local/schemas/protocol/event-data.schema.json", "title": "Distributed AI VTuber Event Data Schemas", "type": "object", "additionalProperties": false,
  "required": ["event_types", "definitions"],
  "definitions": {"rtp_timestamp": {"type": "integer", "minimum": 0}, "rtp_ssrc": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "rtp_codec": {"type": "object", "additionalProperties": false, "required": ["format", "clock_rate_hz", "channels", "payload_type", "samples_per_frame"], "properties": {"format": {"const": "L16"}, "clock_rate_hz": {"const": 16000}, "channels": {"const": 1}, "payload_type": {"const": 96}, "samples_per_frame": {"const": 320}}}, "rtp_endpoint": {"type": "object", "additionalProperties": false, "required": ["host", "port"], "properties": {"host": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, "stream_state": {"enum": ["queued", "playing", "paused", "finished", "cancelled", "error"]}},
  "event_types": {
    "audience.input": {"required": ["input_id", "origin", "text", "received_at"]}, "llm.request": {"required": ["request_id", "prompt"]}, "llm.response.delta": {"required": ["request_id", "delta_text", "index"]}, "llm.response.final": {"required": ["request_id", "text", "finish_reason"]}, "llm.response.error": {"required": ["request_id", "error"]},
    "media.rtp.source.register": {"additionalProperties": false, "required": ["stream_id", "ssrc", "codec", "rtp_endpoint"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "ssrc": {"$ref": "#/definitions/rtp_ssrc"}, "codec": {"$ref": "#/definitions/rtp_codec"}, "rtp_endpoint": {"$ref": "#/definitions/rtp_endpoint"}}},
    "media.rtp.source.ready": {"additionalProperties": false, "required": ["stream_id", "ssrc"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "ssrc": {"$ref": "#/definitions/rtp_ssrc"}}},
    "media.rtp.sink.register": {"additionalProperties": false, "required": ["stream_id", "codec", "rtp_endpoint"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "codec": {"$ref": "#/definitions/rtp_codec"}, "rtp_endpoint": {"$ref": "#/definitions/rtp_endpoint"}}},
    "media.rtp.sink.ready": {"additionalProperties": false, "required": ["stream_id"], "properties": {"stream_id": {"type": "string", "minLength": 1}}},
    "media.stream.command": {"additionalProperties": false, "required": ["command_id", "stream_id", "start_rtp_timestamp", "ssrc", "codec", "rtp_endpoint"], "properties": {"command_id": {"type": "string", "minLength": 1}, "stream_id": {"type": "string", "minLength": 1}, "start_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}, "ssrc": {"$ref": "#/definitions/rtp_ssrc"}, "codec": {"$ref": "#/definitions/rtp_codec"}, "rtp_endpoint": {"$ref": "#/definitions/rtp_endpoint"}}},
    "media.stream.end": {"additionalProperties": false, "required": ["stream_id", "cancellation_epoch", "ssrc"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "cancellation_epoch": {"type": "integer", "minimum": 0}, "ssrc": {"$ref": "#/definitions/rtp_ssrc"}}},
    "media.stream.state": {"required": ["stream_id", "state"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "state": {"$ref": "#/definitions/stream_state"}}},
    "media.stream.flush": {"additionalProperties": false, "required": ["stream_id", "cancellation_epoch", "request_id", "target_generated_ssrc"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "cancellation_epoch": {"type": "integer", "minimum": 0}, "request_id": {"type": "string", "minLength": 1}, "target_generated_ssrc": {"$ref": "#/definitions/rtp_ssrc"}}},
    "media.stream.flush.ack": {"additionalProperties": false, "required": ["stream_id", "cancellation_epoch", "request_id", "target_generated_ssrc"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "cancellation_epoch": {"type": "integer", "minimum": 0}, "request_id": {"type": "string", "minLength": 1}, "target_generated_ssrc": {"$ref": "#/definitions/rtp_ssrc"}}},
    "vtuber.caption.command": {"required": ["caption_id", "text", "audio_stream_id", "start_at_ms", "end_at_ms", "start_rtp_timestamp", "end_rtp_timestamp"], "properties": {"caption_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "audio_stream_id": {"type": "string", "minLength": 1}, "start_at_ms": {"type": "integer", "minimum": 0}, "end_at_ms": {"type": "integer", "minimum": 1}, "start_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}, "end_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}}},
    "vtuber.expression.command": {"required": ["expression_id", "expression", "audio_stream_id", "start_at_ms", "end_at_ms", "start_rtp_timestamp", "end_rtp_timestamp"], "properties": {"expression_id": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "audio_stream_id": {"type": "string", "minLength": 1}, "start_at_ms": {"type": "integer", "minimum": 0}, "end_at_ms": {"type": "integer", "minimum": 1}, "start_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}, "end_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}}},
    "vtuber.action.command": {"required": ["action_id", "action", "audio_stream_id", "start_at_ms", "end_at_ms", "start_rtp_timestamp", "end_rtp_timestamp"], "properties": {"action_id": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "audio_stream_id": {"type": "string", "minLength": 1}, "start_at_ms": {"type": "integer", "minimum": 0}, "end_at_ms": {"type": "integer", "minimum": 1}, "start_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}, "end_rtp_timestamp": {"$ref": "#/definitions/rtp_timestamp"}}},
    "vtuber.scene.command": {"required": ["scene_id", "scene", "page"], "properties": {"scene_id": {"type": "string", "minLength": 1}, "scene": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}}},
    "presentation.load.command": {"required": ["command_id", "deck_id", "page"], "properties": {"command_id": {"type": "string", "minLength": 1}, "deck_id": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}}},
    "presentation.play.command": {"required": ["command_id", "deck_id", "page"], "properties": {"command_id": {"type": "string", "minLength": 1}, "deck_id": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}}},
    "presentation.navigate.command": {"required": ["command_id", "deck_id", "page"], "properties": {"command_id": {"type": "string", "minLength": 1}, "deck_id": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}}},
    "presentation.result": {"required": ["command_id", "succeeded"], "properties": {"command_id": {"type": "string", "minLength": 1}, "succeeded": {"type": "boolean"}, "reason": {"type": "string"}}},
    "profile.enroll.command": {"additionalProperties": false, "required": ["profile_id", "preferred_name", "encrypted_template", "consented"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "preferred_name": {"type": "string", "minLength": 1}, "encrypted_template": {"type": "string", "minLength": 1}, "consented": {"const": true}}},
    "profile.revoke.command": {"additionalProperties": false, "required": ["profile_id"], "properties": {"profile_id": {"type": "string", "minLength": 1}}},
    "voice.evidence": {"additionalProperties": false, "required": ["stream_id", "rtp_start_timestamp", "rtp_end_timestamp", "embedding_model_revision", "embedding", "quality"], "properties": {"stream_id": {"type": "string", "minLength": 1}, "rtp_start_timestamp": {"$ref": "#/definitions/rtp_timestamp"}, "rtp_end_timestamp": {"$ref": "#/definitions/rtp_timestamp"}, "embedding_model_revision": {"type": "string", "minLength": 1}, "embedding": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "number"}}, "quality": {"type": "object", "additionalProperties": false, "required": ["speech_ms", "score"], "properties": {"speech_ms": {"type": "integer", "minimum": 1}, "score": {"type": "number", "minimum": 0, "maximum": 1}}}}},
    "action.command": {"additionalProperties": false, "required": ["command_id", "action"], "properties": {"command_id": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}}},
    "context.reset.command": {"additionalProperties": false, "required": [], "properties": {}},
    "memory.delete.command": {"additionalProperties": false, "required": ["key"], "properties": {"key": {"type": "string", "minLength": 1}}},
    "action.result": {"additionalProperties": false, "required": ["command_id", "succeeded"], "properties": {"command_id": {"type": "string", "minLength": 1}, "succeeded": {"type": "boolean"}}},
    "health.heartbeat": {"required": ["service", "service_version", "status", "observed_at"]}, "error": {"required": ["code", "message"]}, "cancel": {"required": ["reason"]}, "session.created": {"required": ["created_at"]}, "session.ended": {"required": ["ended_at", "reason"]}
  }
}
